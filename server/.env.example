PORT=8787

# 高德 Web 服务 Key。不要提交真实 key。
AMAP_WEB_SERVICE_KEY=

# OpenAI-compatible AI API. 留空时 /api/explain 使用规则式降级解释。
AI_API_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# MySQL 可选。留空或未安装 mysql2 时，后端仍可启动。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nanning_webgis
